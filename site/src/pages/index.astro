---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import heroPhoto from '../assets/photos/gitarre-wiese.jpg';
import portrait from '../assets/photos/portrait.jpg';
import stage from '../assets/photos/konzert-buehne.jpg';

const features = [
  { href: '/unterricht', icon: 'book', title: 'Unterricht', text: 'Gitarrenunterricht für Kinder, Jugendliche und Erwachsene – auch online.' },
  { href: '/konzerte', icon: 'calendar', title: 'Veranstaltungen', text: 'Musik für Ihre Anlässe: Hochzeiten, Taufen, Vernissagen und mehr.' },
  { href: '/buecher', icon: 'bag', title: 'Shop', text: 'Lehrbücher, Übungshefte, CDs …' },
  { href: '/stimmen', icon: 'quote', title: 'Referenzen', text: 'Ihre Meinung ist mir wichtig.' },
] as const;

const lessons = [
  { icon: 'music', title: 'Gitarrenunterricht', text: 'Für Kinder ab 4 Jahren, Jugendliche und musikbegeisterte Erwachsene.' },
  { icon: 'mic', title: 'Sicher auftreten', text: 'Mentaltraining für sicheres Auftreten und Vorspiel ohne Noten.' },
  { icon: 'cap', title: 'Aufnahmeprüfungen', text: 'Vorbereitung auf die Aufnahmeprüfung an Unis, BAfEP oder auf Wettbewerbe.' },
  { icon: 'users', title: 'Kursangebote', text: 'Gemeinsam musizieren – ab 3 Personen.' },
] as const;

const quotes = [
  ['Er arbeitet mit mir in meinem Tempo und lässt mir Zeit, die Lieder zu lernen.', 'Kim Scheucher, 12 Jahre'],
  ['Spielerisch und mit sehr viel Herzlichkeit wird den Kindern das Gitarrespielen beigebracht. Die Freude am Musizieren wird authentisch vermittelt.', 'Christine Loder'],
  ['Andy hat unsere Hochzeit im Schlossgarten Pöllau musikalisch wunderschön untermalt – das war das Tüpfchen auf dem i.', 'Nikolai & Petra'],
];
---
<Base title="Start" home>
  <section class="hero">
    <Image class="hero-img" src={heroPhoto} alt="" widths={[800, 1280, 1920]} sizes="100vw" quality={70} loading="eager" fetchpriority="high" />
    <div class="wrap">
      <span class="eyebrow">Gitarrist · Pädagoge · Songwriter</span>
      <h1>Andreas Pöttler</h1>
      <p class="lead">Gitarrenunterricht, Konzerte und Musik für Ihre Anlässe – mit Leidenschaft, Geduld und Freude an der Musik.</p>
      <div class="actions">
        <a class="btn light" href={url('/unterricht#termin')}>Probestunde buchen</a>
        <a class="btn outline-light" href={url('/kontakt')}>Konzert anfragen</a>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="wrap grid f4">
      {features.map((f) => (
        <a class="card" href={url(f.href)}>
          <span class="ico"><Icon name={f.icon} /></span>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
          <span class="more">Mehr erfahren <Icon name="arrow" size={18} /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="block">
    <div class="wrap split">
      <div class="portrait"><Image src={portrait} alt="Andreas Pöttler mit Gitarre" widths={[480, 720, 960]} sizes="(min-width: 52rem) 35rem, 100vw" quality={75} loading="lazy" /></div>
      <div>
        <span class="eyebrow" style="color:var(--blue)">Über mich</span>
        <h2>Aus dem Hobby wurde Leidenschaft</h2>
        <p class="lead">Mit sieben Jahren begann ich an der Musikschule Pöllau mit der Gitarre. Heute unterrichte ich an der Musikschule Weiz – und meine SchülerInnen haben seit 2016 mehr als 20 erste Preise bei Wettbewerben gewonnen.</p>
        <ul class="checks">
          <li>Konzertfach Gitarre und Instrumentalpädagogik, jeweils mit Auszeichnung</li>
          <li>Auftritte in Österreich, Deutschland, Polen, Ungarn und Kanada</li>
          <li>Dozent bei Meisterkursen, Juror bei Wettbewerben</li>
        </ul>
        <a class="btn ghost" href={url('/vita')}>Mehr über mich</a>
      </div>
    </div>
  </section>

  <section class="block tint">
    <div class="wrap">
      <div class="sec-head">
        <h2>Unterricht</h2>
        <p>Individuell, im eigenen Tempo und mit viel Raum für Lieblingslieder.</p>
      </div>
      <div class="grid f4">
        {lessons.map((l) => (
          <div class="card">
            <span class="ico"><Icon name={l.icon} /></span>
            <h3>{l.title}</h3>
            <p>{l.text}</p>
            <a class="btn ghost" href={url('/unterricht')}>Mehr erfahren</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap split rev">
      <div class="portrait" style="aspect-ratio:4/3"><Image src={stage} alt="Andreas Pöttler im Konzert auf der Bühne" widths={[480, 720, 960]} sizes="(min-width: 52rem) 35rem, 100vw" quality={75} loading="lazy" /></div>
      <div>
        <span class="eyebrow" style="color:var(--blue)">Veranstaltungen</span>
        <h2>Musik für Ihre Anlässe</h2>
        <p class="lead">Jeder Anlass ist ein Anlass für Musik.</p>
        <ul class="checks">
          <li>Hochzeiten</li>
          <li>Taufen</li>
          <li>Musikalische Umrahmung diverser Feierlichkeiten</li>
          <li>Solo oder als Duo (Gesang / Gitarre) mit <a href={url('/laurandy')}>Laurandy</a></li>
        </ul>
        <a class="btn" href={url('/konzerte')}>Mehr zu Konzerten</a>
      </div>
    </div>
  </section>

  <section class="block tint">
    <div class="wrap">
      <div class="sec-head">
        <h2>Referenzen</h2>
        <p>Das sagen SchülerInnen und Auftraggeber.</p>
      </div>
      <div class="grid f3">
        {quotes.map(([text, who]) => (
          <figure class="quote"><p>{text}</p><cite>{who}</cite></figure>
        ))}
      </div>
      <p style="margin-top:2rem"><a class="btn ghost" href={url('/stimmen')}>Alle Stimmen</a></p>
    </div>
  </section>

  <section class="block dark">
    <div class="wrap split">
      <div>
        <h2>Kontakt</h2>
        <p>Für ein unverbindliches Erstgespräch oder Fragen zu Gitarrenunterricht und Konzerten – ich freue mich darauf, Sie kennenzulernen.</p>
        <ul class="contact-list">
          <li><span class="ico"><Icon name="phone" /></span><a href="tel:+436811085410">+43 681 108 541 10</a></li>
          <li><span class="ico"><Icon name="mail" /></span><a href="mailto:poettler.andreas@gmx.at">poettler.andreas@gmx.at</a></li>
          <li><span class="ico"><Icon name="pin" /></span><span>Rabenwald 135, 8225 Pöllau</span></li>
        </ul>
      </div>
      <div>
        <h3>Gleich einen Termin sichern</h3>
        <p>Wählen Sie online einen freien Unterrichtstermin – ich bestätige per E-Mail.</p>
        <a class="btn light" href={url('/unterricht#termin')}>Termin buchen</a>
      </div>
    </div>
  </section>
</Base>
