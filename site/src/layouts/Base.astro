---
import { url, stripBase } from '../lib/url';
import { preview } from '../lib/config';
import '@fontsource-variable/mulish';
import '../styles/global.css';

interface Props {
  title: string;
  heading?: string;      // page heading (defaults to title)
  subtitle?: string;
  description?: string;
  home?: boolean;        // home page renders its own sections, without page header
}
const { title, heading, subtitle, description = 'Andreas Pöttler – Gitarrist, Pädagoge und Songwriter', home = false } = Astro.props;
// built pages are '/vita.html' (build.format 'file') but are served as '/vita'
const clean = (p: string) => p.replace(/\.html$/, '').replace(/\/index$/, '/');
const path = clean(stripBase(Astro.url.pathname)).replace(/\/$/, '');
const nav = [
  ['/vita', 'Über mich'],
  ['/konzerte', 'Konzerte'],
  ['/laurandy', 'Laurandy'],
  ['/fotos', 'Fotos'],
  ['/videos', 'Videos'],
  ['/stimmen', 'Stimmen'],
  ['/unterricht', 'Unterricht'],
  ['/buecher', 'Bücher'],
  ['/kontakt', 'Kontakt'],
];
const full = home ? 'Andreas Pöttler – Gitarrist, Pädagoge, Songwriter' : `${title} – Andreas Pöttler`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1f3a" />
    {preview ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={new URL(clean(Astro.url.pathname), Astro.site)} />}
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={url('/')}>Andreas Pöttler</a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mainnav">Menü</button>
        <nav class="main" id="mainnav" aria-label="Hauptnavigation">
          <ul>
            {nav.map(([href, label]) => (
              <li><a href={url(href)} aria-current={path === href ? 'page' : undefined}>{label}</a></li>
            ))}
            <li><a class="cta" href={url('/unterricht#termin')}>Termin buchen</a></li>
          </ul>
        </nav>
      </div>
    </header>

    {home ? (
      <main id="inhalt"><slot /></main>
    ) : (
      <>
        <div class="page-head">
          <div class="wrap">
            <h1>{heading ?? title}</h1>
            {subtitle && <p>{subtitle}</p>}
          </div>
        </div>
        <main class="inner" id="inhalt"><div class="wrap narrow"><slot /></div></main>
      </>
    )}

    <footer class="site">
      <div class="wrap">
        <div class="cols">
          <div>
            <h2>Andreas Pöttler</h2>
            <p>Gitarrist · Pädagoge · Songwriter<br />Gitarrenunterricht, Konzerte und Musik für Ihre Anlässe.</p>
          </div>
          <div>
            <h2>Seiten</h2>
            <ul>{nav.map(([href, label]) => <li><a href={url(href)}>{label}</a></li>)}</ul>
          </div>
          <div>
            <h2>Kontakt</h2>
            <ul>
              <li><a href="tel:+436811085410">+43 681 108 541 10</a></li>
              <li><a href="mailto:poettler.andreas@gmx.at">poettler.andreas@gmx.at</a></li>
              <li>Rabenwald 135, 8225 Pöllau</li>
            </ul>
          </div>
        </div>
        <div class="legal">
          <span>© {new Date().getFullYear()} Andreas Pöttler</span>
          <span><a href={url('/impressum')}>Impressum</a> &nbsp;·&nbsp; <a href={url('/datenschutz')}>Datenschutz</a></span>
        </div>
      </div>
    </footer>
    <script>
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
      const nav = document.getElementById('mainnav')!;
      btn.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
